{
  "display_information": {
    "name": "Reacji Notifier",
    "description": "リアクション通知Bot"
  },
  "features": {
    "bot_user": {
      "display_name": "Reacji Notifier",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "chat:write",
        "reactions:read",
        "users:read",
        "channels:read",
        "groups:history",
        "im:history",
        "mpim:history"
      ]
    }
  },
  "event_subscriptions": {
    "bot_events": [
      "reaction_added"
    ]
  },
  "settings": {
    "org_deploy_enabled": true,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
